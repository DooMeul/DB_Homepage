<!DOCTYPE html>
<html lang="ko">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= title %> - 포트폴리오 허브</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="/css/style.css">
</head>
<body>
	<%- include('partials/nav') %>

	<main class="container mt-5">
		<div class="row mb-4">
			<div class="col-md-8">
				<h1 class="h3">포트폴리오</h1>
				<p class="text-muted">다양한 개발자 프로젝트를 확인해보세요.</p>
			</div>
			<% if (user) { %>
				<div class="col-md-4 text-end">
					<a href="/portfolios/new" class="btn btn-primary btn-sm">포트폴리오 업로드</a>
				</div>
			<% } %>
		</div>

		<% if (portfolios && portfolios.length > 0) { %>
			<div class="row">
				<% portfolios.forEach(portfolio => { %>
					<div class="col-md-4 mb-4">
						<div class="card h-100">
							<div class="card-body d-flex flex-column">
								<h5 class="card-title"><%= portfolio.title %></h5>
								<p class="text-muted mb-2">작성자: <%= portfolio.user_name || '익명' %></p>
								<div class="meta-row" style="justify-content:flex-start;">
									<div class="meta-item">작성일: <strong><%= portfolio.created_at ? new Date(portfolio.created_at).toLocaleDateString('ko-KR') : '-' %></strong></div>
									<% if (portfolio.category) { %>
										<div class="meta-item">카테고리: <strong><%= portfolio.category %></strong></div>
									<% } %>
								</div>
								<p class="card-text text-truncate" style="max-height:3.6em;"><%= portfolio.description %></p>
								<div class="mt-auto">
									<a href="/portfolios/<%= portfolio.portfolio_id %>" class="btn btn-sm btn-outline-primary">상세 보기</a>
								</div>
							</div>
						</div>
					</div>
				<% }); %>
			</div>
		<% } else { %>
			<div class="alert alert-info">등록된 포트폴리오가 없습니다. <% if (user) { %><a href="/portfolios/new">첫 포트폴리오를 올려보세요!</a><% } %></div>
		<% } %>
	</main>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
