<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - 포트폴리오 허브</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/nav') %>

    <main class="container mt-5">
        <div class="row align-items-center mb-4">
            <div class="col-md-8">
                <h1 class="h4 fw-semibold">전체 포트폴리오</h1>
                <p class="text-muted mb-0">다양한 개발자의 프로젝트를 살펴보세요.</p>
            </div>
            <% if (user) { %>
                <div class="col-md-4 text-end">
                    <a href="/portfolios/new" class="btn btn-sm btn-primary">포트폴리오 업로드</a>
                </div>
            <% } %>
        </div>

        <% if (portfolios && portfolios.length > 0) { %>
            <div class="row">
                <% portfolios.forEach(portfolio => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="portfolio-hero mb-3">
                                    <div class="hero-title"><%= portfolio.title %></div>
                                </div>
                                <p class="portfolio-meta mb-2 text-muted">작성자: <%= portfolio.user_name || '익명' %></p>
                                <div class="meta-row" style="justify-content:flex-start;">
                                    <div class="meta-item">작성일: <strong><%= portfolio.created_at ? new Date(portfolio.created_at).toLocaleDateString('ko-KR') : '-' %></strong></div>
                                    <% if (portfolio.category) { %>
                                        <div class="meta-item">카테고리: <strong><%= portfolio.category %></strong></div>
                                    <% } %>
                                </div>
                                <p class="card-text text-truncate mb-3" style="max-height:3.6em;"><%= portfolio.description %></p>
                                <% if (portfolio.technologies) { %>
                                    <div class="mt-auto">
                                        <% portfolio.technologies.split(',').forEach(tech => { %>
                                            <span class="badge"><%= tech.trim() %></span>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                            <div class="card-footer bg-white text-end">
                                <a href="/portfolios/<%= portfolio.portfolio_id %>" class="btn btn-sm btn-outline-primary">상세 보기</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>

            <!-- Pagination -->
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <% if (currentPage > 1) { %>
                        <li class="page-item">
                            <a class="page-link" href="/portfolios?page=1">처음</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="/portfolios?page=<%= currentPage - 1 %>">이전</a>
                        </li>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link" href="/portfolios?page=<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <li class="page-item">
                            <a class="page-link" href="/portfolios?page=<%= currentPage + 1 %>">다음</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="/portfolios?page=<%= totalPages %>">마지막</a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        <% } else { %>
            <div class="alert alert-info">
                📭 등록된 포트폴리오가 없습니다. <% if (user) { %><a href="/portfolios/new">가장 먼저 업로드해보세요!</a><% } %>
            </div>
        <% } %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
