<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - 포트폴리오 허브</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container mt-5">
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <div class="portfolio-hero portfolio-hero--large mb-3">
                            <div class="hero-title"><%= portfolio.title %></div>
                        </div>

                        <p class="portfolio-meta text-muted text-center mb-2"><small>작성자: <strong><%= portfolio.user_name || '익명' %></strong></small></p>

                        <div class="meta-row">
                            <div class="meta-item">작성일: <strong><%= portfolio.created_at ? new Date(portfolio.created_at).toLocaleDateString('ko-KR') : '-' %></strong></div>
                            <% if (typeof portfolio.category !== 'undefined') { %>
                                <div class="meta-item">카테고리: <strong><%= portfolio.category || '미분류' %></strong></div>
                            <% } %>
                        </div>

                        <section aria-labelledby="desc-heading" class="mt-3">
                            <div id="desc-heading" class="section-title">설명</div>
                            <div class="portfolio-description"><%= portfolio.description || '설명이 없습니다.' %></div>
                        </section>

                        <section class="mt-3" aria-labelledby="tech-heading">
                            <div id="tech-heading" class="section-title">기술 스택</div>
                            <% if (portfolio.technologies) { %>
                                <div class="tech-list">
                                    <% portfolio.technologies.split(',').forEach(tech => { %>
                                        <span class="badge"><%= tech.trim() %></span>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <p class="text-muted">등록된 기술이 없습니다</p>
                            <% } %>
                        </section>

                        <section class="mt-3" aria-labelledby="links-heading">
                            <div id="links-heading" class="section-title">링크</div>
                            <div class="link-actions">
                                <% if (portfolio.github_url) { %>
                                    <a href="<%= portfolio.github_url %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                                        GitHub 저장소
                                    </a>
                                <% } %>
                                <% if (portfolio.demo_url) { %>
                                    <a href="<%= portfolio.demo_url %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                                        데모 보기
                                    </a>
                                <% } %>
                            </div>
                        </section>

                        <% if (user && user.user_id === portfolio.user_id) { %>
                            <div class="owner-actions">
                                <a href="/portfolios/<%= portfolio.portfolio_id %>/edit" class="btn btn-outline-warning">수정</a>
                                <form method="POST" action="/portfolios/<%= portfolio.portfolio_id %>/delete" style="display:inline;">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('정말 삭제하시겠습니까?')">삭제</button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-8">
                <a href="/portfolios" class="btn btn-secondary">← 포트폴리오 목록으로</a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
