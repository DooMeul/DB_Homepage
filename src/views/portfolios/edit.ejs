<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - 포트폴리오 허브</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/nav') %>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title mb-4">포트폴리오 수정</h3>
                        <form method="POST" action="/portfolios/<%= portfolio.portfolio_id %>/edit">
                            <div class="mb-3">
                                <label for="title" class="form-label">프로젝트 제목</label>
                                <input type="text" class="form-control" id="title" name="title" value="<%= portfolio.title %>" required>
                            </div>
                            <div class="mb-3">
                                <label for="description" class="form-label">설명</label>
                                <textarea class="form-control" id="description" name="description" rows="4" required><%= portfolio.description %></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="technologies" class="form-label">기술 스택 (쉼표로 구분)</label>
                                <input type="text" class="form-control" id="technologies" name="technologies" value="<%= portfolio.technologies || '' %>">
                            </div>
                            <div class="mb-3">
                                <label for="category" class="form-label">카테고리 (선택)</label>
                                <select id="category" name="category" class="form-select">
                                    <option value="" <%= !portfolio.category ? 'selected' : '' %>>-- 선택 안함 --</option>
                                    <option value="웹" <%= portfolio.category === '웹' ? 'selected' : '' %>>웹</option>
                                    <option value="모바일" <%= portfolio.category === '모바일' ? 'selected' : '' %>>모바일</option>
                                    <option value="데이터 사이언스" <%= portfolio.category === '데이터 사이언스' ? 'selected' : '' %>>데이터 사이언스</option>
                                    <option value="인프라" <%= portfolio.category === '인프라' ? 'selected' : '' %>>인프라</option>
                                    <option value="게임" <%= portfolio.category === '게임' ? 'selected' : '' %>>게임</option>
                                    <option value="기타" <%= portfolio.category === '기타' ? 'selected' : '' %>>기타</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="github_url" class="form-label">GitHub URL</label>
                                <input type="url" class="form-control" id="github_url" name="github_url" value="<%= portfolio.github_url %>" required>
                            </div>
                            <div class="mb-3">
                                <label for="demo_url" class="form-label">데모 URL (선택)</label>
                                <input type="url" class="form-control" id="demo_url" name="demo_url" value="<%= portfolio.demo_url || '' %>">
                            </div>
                            <div class="d-flex justify-content-end gap-2">
                                <a href="/portfolios/<%= portfolio.portfolio_id %>" class="btn btn-outline-secondary">취소</a>
                                <button type="submit" class="btn btn-primary">수정 완료</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
